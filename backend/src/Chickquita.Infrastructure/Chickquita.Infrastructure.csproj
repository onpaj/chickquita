<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Chickquita.Application\Chickquita.Application.csproj" />
    <ProjectReference Include="..\Chickquita.Domain\Chickquita.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Clerk.Net" Version="1.15.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.2" />
    <!--
      Pin the Microsoft.IdentityModel stack to one version. JwtBearer 8.0.2 brings
      Protocols.OpenIdConnect 7.1.2, while other packages pull Tokens/JsonWebTokens 8.14.0.
      That mix makes the OIDC metadata serializer silently drop jwks_uri, so no signing key is
      ever fetched and every authenticated request fails with 401. Keep these versions equal.
    -->
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.14.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.2" />
    <PackageReference Include="Svix" Version="1.84.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
